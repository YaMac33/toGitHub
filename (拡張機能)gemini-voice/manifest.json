{
  "manifest_version": 3,
  "name": "Gemini ボイス",
  "version": "1.0.0",
  "description": "Webページの読み上げと音声入力を、Gemini APIで。読み上げはAPIキーなしの「端末の声」でも使えます。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "offscreen", "tts", "clipboardWrite"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gemini ボイス",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-read": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "ページの読み上げを開始／停止"
    },
    "toggle-dictation": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "音声入力を開始／停止（停止すると文字にします）"
    }
  }
}
